# 服务端项目档案提取，禁止使用 VITE_ 前缀
# 支持 Gemini 或 DeepSeek（若配置 GEMINI_API_KEY，默认使用 Gemini 2.5 Flash）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# 备选：DeepSeek 模型
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：提高 GitHub README API 的请求限额
GITHUB_TOKEN=

# GitHub OAuth；Client Secret 只能保存在服务端环境中
GITHUB_CLIENT_ID=Iv23lipOXPUiR5ZQFSTr
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# 可选：Node 服务访问 GitHub 使用的 HTTP 代理
HTTPS_PROXY=http://127.0.0.1:7890

# 项目能力档案（默认每批100个，并发3；7天检查一次变化）
PROFILE_BATCH_SIZE=100
PROFILE_CONCURRENCY=3
STARROCKS_MYSQL_HOST=127.0.0.1
STARROCKS_MYSQL_PORT=9030
STARROCKS_USER=root
STARROCKS_PASSWORD=

# 项目向量索引（若配置 GEMINI_API_KEY，默认使用 text-embedding-004，维度 768；否则可配置 SiliconFlow BAAI/bge-m3，维度 1024）
# GEMINI_API_KEY=
# EMBEDDING_MODEL=text-embedding-004
# EMBEDDING_DIMENSION=768
# QDRANT_COLLECTION=github_projects_gemini_v1

# 备选：SiliconFlow + Qdrant
SILICONFLOW_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=github_projects_profiles_v1

# 默认交由 DolphinScheduler 调度；单机替代方案才设为true。
ENABLE_VECTOR_SCHEDULER=false
VECTOR_INDEX_CRON=30 10 * * *
VECTOR_INDEX_TIMEZONE=Asia/Shanghai
