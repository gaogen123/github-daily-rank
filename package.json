{
  "name": "github-daily-rank-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "generate:data": "python3 scripts/exports/generate_data_from_starrocks.py",
    "crawl:trending": "node scripts/trending/crawl-trending.mjs",
    "load:trending": "node scripts/trending/load-trending-to-starrocks.mjs",
    "load:daily-rank": "python3 scripts/rankings/load_daily_rank_to_starrocks.py",
    "load:daily-rank:incremental": "python3 scripts/rankings/load_daily_rank_incremental.py",
    "load:weekly-rank": "python3 scripts/rankings/load_weekly_rank_to_starrocks.py",
    "load:weekly-rank:incremental": "python3 scripts/rankings/load_weekly_rank_incremental.py",
    "load:monthly-rank": "python3 scripts/rankings/load_monthly_rank_to_starrocks.py",
    "load:monthly-rank:incremental": "python3 scripts/rankings/load_monthly_rank_incremental.py",
    "index:projects": "node scripts/projects/index-projects.mjs",
    "dev": "python3 scripts/exports/generate_data_from_starrocks.py && node server.mjs --dev",
    "build": "python3 scripts/exports/generate_data_from_starrocks.py && vite build",
    "start": "node server.mjs",
    "preview": "vite preview",
    "test": "node --test",
    "profiles:init": "python3 scripts/projects/project_profiles.py --init-table",
    "profiles:refresh": "python3 scripts/projects/project_profiles.py",
    "profiles:export": "python3 scripts/projects/project_profiles.py --export-only",
    "profiles:evaluate": "node scripts/projects/evaluate-profile-search.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "node-cron": "^4.6.0",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "vite": "^7.1.3"
  }
}
